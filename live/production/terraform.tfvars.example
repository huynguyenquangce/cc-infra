aws_account_id = "123456789012" # REPLACE
aws_region = "us-east-1"
# API Proxy: CloudFront (*.cloudfront.net HTTPS) -> internal ALB in private-a/b -> backends over VPN.
# No domain or ACM. Commerce allowlists 10.0.10.0/24 and 10.0.11.0/24 as source to TCP 9010.
enable_alb = false
# Fill verified backend IPs, not the public IPs of VPN gateways. No IP is invented.
# All targets use HTTP 9010. Container port can stay 8000 behind host mapping 9010:8000.
backend_targets = {
  # server-1 = "REPLACE_PRIVATE_IP_1"
  # server-2 = "REPLACE_PRIVATE_IP_2"
  # server-3 = "REPLACE_PRIVATE_IP_3"
  # server-4 = "REPLACE_PRIVATE_IP_4"
}
# Supply recipients or existing SNS ARNs before enable_alb=true.
alert_emails = []
additional_alarm_action_arns = []
enable_deletion_protection = true
# Non-empty log buckets are retained unless you explicitly opt into deleting logs.
force_destroy_logs = false
log_retention_days = 90
idle_timeout_seconds = 60
health_check_path = "/health" # Not /api/health. Currently liveness, not full readiness.
minimum_healthy_targets = 1 # Set according to actual active/standby backend policy.
error_count_threshold = 5
latency_p95_seconds = 2

# --- MCP Server ------------------------------------------------------------
# Order: networking contract v3 (NAT, endpoints, ECR) -> push the first image -> enable_mcp=true,
# mcp_run_service=false -> fill cc-mcp/production/squirrel (and genesis) with put-secret-value -> mcp_run_service=true.
enable_mcp      = false
mcp_run_service = false
# mcp_initial_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/cc-mcp-server@sha256:REPLACE"
mcp_enabled_features = ["squirrel"] # add "genesis" once Commerce confirms the GGAPI endpoint over VPN
mcp_app_environment = {
  LOG_LEVEL              = "INFO"
  MCP_AUTH_JWKS_URL      = "https://REPLACE-commerce-gateway/.well-known/jwks.json"
  MCP_AUTH_ISSUER        = "https://REPLACE-commerce-gateway/"
  MCP_AUTH_AUDIENCE_BASE = "https://REPLACE-mcp-audience"
  SQUIRREL_BASE_URL      = "https://REPLACE.squirrel.example"
  # GENESIS_BASE_URL     = "https://REPLACE/GGAPI/GGAPI.svc/json"
  # GENESIS_TIMEZONE     = "America/Los_Angeles"
}
mcp_vendor_egress_cidrs = ["0.0.0.0/0"] # narrow to Squirrel CIDRs when published
# mcp_vpn_egress_targets = { genesis = { cidr = "172.19.16.REPLACE/32", port = 443 } }
mcp_min_tasks = 2 # one task per AZ at all times
mcp_max_tasks = 3
